      "info":    { "bg": "#E8F0FE", "text": "#1556BD" },
      "warning": { "bg": "#FFF4E0", "text": "#6B4100", "line": "#C77400" },
      "error":   { "bg": "#FDECEA", "text": "#A50E0E" },
      "offline": { "dot": "#8A919C" }
    }
  },
  "type": {
    "family": "IBM Plex Sans",
    "mono": "IBM Plex Mono (ports, paths, log times, tool names)",
    "fallback": "Segoe UI",
    "size": { "meta": 11.5, "small": 12, "body": 13, "tab": 13.5, "boardTitle": 36 },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },
  "size": {
    "paneWidth": 420,
    "titleBar": 32,
    "segmentButton": 30,
    "familyRow": 44,
    "fileRow": 46,
    "logRow": 40,
    "footerButton": 34,
    "statusDot": 9
  },
  "radius": { "pane": 8, "card": 6, "button": 4, "chip": 10, "segment": 6 },
  "spacing": { "panePadding": 12, "footerPadding": "8 10", "rowGap": 2 }
}
