{
  "name": "Formcraft Revit MCP · Formcraft Browser",
  "source": "Formcraft Revit MCP — Design Canvas (follows the Formcraft MEP Suite canvas)",
  "color": {
    "canvas": "#F6F7F9",
    "surface": "#FFFFFF",
    "surfaceMuted": "#F8F9FA",
    "titleBar": "#F1F3F5",
    "ribbonStrip": "#EEF0F3",
    "segmentTrack": "#EEF0F3",
    "selectedRow": "#F1F5FE",
    "text": "#1A1D21",
    "textBody": "#3B424D",
    "textSecondary": "#4A515C",
    "textMeta": "#5B6270",
    "textDisabled": "#6B7280",
    "iconMuted": "#8A919C",
    "border": "#C9CED6",
    "borderPane": "#D5D9DF",
    "divider": "#E3E6EA",
    "dividerLight": "#EEF0F3",
    "accent": "#1F6FEB",
    "accentHover": "#1556BD",
    "status": {
