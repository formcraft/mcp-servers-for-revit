<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Formcraft Browser styles (handoff design/tokens.json). Colours are DynamicResource tokens from Theme.Apply(). -->

    <Style TargetType="TextBlock" x:Key="Meta">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMeta}"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="Label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="MonoMeta">
        <Setter Property="FontFamily" Value="{DynamicResource Mono}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMeta}"/>
    </Style>

    <CornerRadius x:Key="ButtonRadius">4</CornerRadius>

    <!-- Secondary button: white, grey border, 4 px radius, 34 px high -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Sans}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource ButtonRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource ButtonHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource DisabledBg}"/>
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource DisabledBorder}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Main action: filled blue -->
    <Style TargetType="Button" x:Key="Primary" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource ButtonRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentHover}"/>
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource DisabledBg}"/>
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource DisabledBorder}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="Small" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="8,2"/>
    </Style>
    <Style TargetType="Button" x:Key="SmallPrimary" BasedOn="{StaticResource Primary}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="10,2"/>
    </Style>

    <!-- Compact footer (HANDOFF_NEXT C1): 24 px buttons, 11.5 px text, 3 px radius, 4 px gap; every section's footer -->
    <Style TargetType="Button" x:Key="Footer" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>
    <Style TargetType="Button" x:Key="FooterPrimary" BasedOn="{StaticResource Primary}">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>

    <!-- Segmented section tabs -->
    <Style TargetType="RadioButton" x:Key="SegTab">
        <Setter Property="FontFamily" Value="{DynamicResource Sans}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="B" Background="Transparent" CornerRadius="4" Padding="6,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource SegmentOn}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource Sans}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Sans}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
        <Setter Property="Padding" Value="5,5"/>
    </Style>

    <!-- Status chip: Kind = ready | warn | done | bad | none -->
    <Style TargetType="Border" x:Key="Chip">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource SegmentTrack}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="ready"><Setter Property="Background" Value="{DynamicResource InfoBg}"/></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="warn"><Setter Property="Background" Value="{DynamicResource WarnBg}"/></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="done"><Setter Property="Background" Value="{DynamicResource OkBg}"/></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="bad"><Setter Property="Background" Value="{DynamicResource ErrBg}"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="TextBlock" x:Key="ChipText">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="ready"><Setter Property="Foreground" Value="{DynamicResource InfoText}"/></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="warn"><Setter Property="Foreground" Value="{DynamicResource WarnText}"/></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="done"><Setter Property="Foreground" Value="{DynamicResource OkText}"/></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="bad"><Setter Property="Foreground" Value="{DynamicResource ErrText}"/></DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Message box in a section: Kind = ready | warn | done | bad | none -->
    <!-- Kind none is the neutral box (HANDOFF_NEXT: #EEF0F3 / #4A515C) -->
    <Style TargetType="Border" x:Key="Callout">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Background" Value="{DynamicResource SegmentTrack}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="ready"><Setter Property="Background" Value="{DynamicResource InfoBg}"/></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="warn"><Setter Property="Background" Value="{DynamicResource WarnBg}"/></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="done"><Setter Property="Background" Value="{DynamicResource OkBg}"/></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="bad"><Setter Property="Background" Value="{DynamicResource ErrBg}"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="TextBlock" x:Key="CalloutText" BasedOn="{StaticResource ChipText}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="17.4"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>

    <!-- Note box under a section's list (HANDOFF_NEXT C1): padding 5 x 8, text 11.5, radius 4 -->
    <Style TargetType="Border" x:Key="NoteBox" BasedOn="{StaticResource Callout}">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="NoteText" BasedOn="{StaticResource CalloutText}">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="LineHeight" Value="16.5"/>
    </Style>
</ResourceDictionary>
